#!/usr/bin/env python3
"""Builds a min/maxtrix metadata blob from a CSV file, for the example min/maxtrix filter module.

    f8_min_maxtrix_metadata_generator data.csv metadata.bin

This is an example, not a general tool: min/maxtrix is one metadata dialect among many, and it lives here
because it is the dialect f8_min_maxtrix_module.c happens to implement. A module using bloom filters or
bounding boxes would ship its own writer alongside it, and nothing outside that pair would change.

The output is the payload of the `f8_metadata` key in a parquet file's key-value metadata, and holds two
kinds of thing:

  * inclusive min/max bounds per integer column, which rule out a value no row can hold
  * a bit matrix per *pair* of narrow integer columns, which rules out a combination no row holds
    together - something no per-column statistic can do

A column or pair with nothing recorded is never skipped, so leaving one out is always safe: it costs a
scan, never a wrong answer.

Nothing about the layout is known to DuckDB. It is a contract between whoever writes the metadata and
whoever wrote the filter module; replace both and the engine is unaffected. See Metadata below for the
bytes.

DuckDB reads the CSV rather than python's csv module, on purpose: the metadata is keyed by column index
and typed as i64, so it has to agree with the schema the parquet writer will produce from the same file.
Re-inferring types here could disagree and key the metadata to the wrong column, which is the one
mistake that silently drops rows.
"""
import argparse
import csv
import io
import os
import pathlib
import shutil
import struct
import subprocess
import sys
from dataclasses import dataclass, field
from typing import List, Optional

# Integer types whose full range fits in the i64 the metadata and the module use. UBIGINT is absent
# deliberately: its upper half does not fit, and a bound we cannot represent must not be written.
BOUNDABLE_TYPES = {
    "TINYINT",
    "SMALLINT",
    "INTEGER",
    "BIGINT",
    "UTINYINT",
    "USMALLINT",
    "UINTEGER",
}

# The widest span a matrix dimension may have. A pair of columns each spanning this much is 256 x 256
# bits, or 8 KiB, which is already a lot to carry in a parquet footer - so a wider pair gets no matrix
# at all rather than a huge one.
MAX_MATRIX_SPAN = 256


@dataclass
class Column:
    """One column of the CSV, at the position the parquet writer will give it."""

    index: int
    name: str
    type: str

    @property
    def boundable(self) -> bool:
        return self.type in BOUNDABLE_TYPES


@dataclass
class ColumnBounds:
    """Inclusive bounds for one column: no value in it is below minimum or above maximum."""

    column_index: int
    name: str
    minimum: int
    maximum: int

    def describe(self) -> str:
        return f"  column {self.column_index} ({self.name}): [{self.minimum}, {self.maximum}]"


@dataclass
class BitMatrix:
    """Which (x, y) combinations of two columns actually occur together in some row.

    One bit per possible pair, indexed relative to each column's minimum, so the whole thing is
    width * height bits. A clear bit is a positive statement - that combination is in no row - which is
    what lets it prune a pair that both columns' bounds allow individually.

    Only worth building when both columns span few enough values; see MAX_MATRIX_SPAN.
    """

    x: ColumnBounds
    y: ColumnBounds
    #! Row-major: bit (dy * width + dx), least significant bit of each byte first.
    bits: bytearray

    @property
    def width(self) -> int:
        return self.x.maximum - self.x.minimum + 1

    @property
    def height(self) -> int:
        return self.y.maximum - self.y.minimum + 1

    @classmethod
    def build(cls, x: ColumnBounds, y: ColumnBounds, pairs) -> "BitMatrix":
        matrix = cls(x=x, y=y, bits=bytearray())
        matrix.bits = bytearray((matrix.width * matrix.height + 7) // 8)
        for x_value, y_value in pairs:
            bit = (y_value - y.minimum) * matrix.width + (x_value - x.minimum)
            matrix.bits[bit // 8] |= 1 << (bit % 8)
        return matrix

    def occupancy(self) -> str:
        set_bits = sum(bin(byte).count("1") for byte in self.bits)
        return f"{set_bits}/{self.width * self.height} combinations"

    def describe(self) -> str:
        return (
            f"  matrix on columns {self.x.column_index},{self.y.column_index} "
            f"({self.x.name},{self.y.name}): {self.width}x{self.height}, {self.occupancy()}, "
            f"{len(self.bits)} bytes"
        )


@dataclass
class Metadata:
    """The whole blob, in the layout f8_min_maxtrix_module.c reads.

        0..4    magic "F8S1"
        4..8    entry count, little endian
        8..     entries, 24 bytes each:
                    0..4    column index, u32
                    4..8    reserved, u32, zero - keeps min 8-byte aligned and leaves room to grow
                    8..16   minimum, i64
                    16..24  maximum, i64
        then, per matrix:
                    0..4    magic "F8M1"
                    4..8    x column index, u32
                    8..12   y column index, u32
                    12..20  x minimum, i64
                    20..28  y minimum, i64
                    28..30  width, u16
                    30..32  height, u16
                    32..    ceil(width * height / 8) bytes of bits

    Entries are sparse and ordered by column index, so bounding one column of fifty costs one entry.

    The matrices come last on purpose: the entry count fixes where the min/max section ends, so a module
    that knows nothing about matrices reads the bounds and ignores the rest. That is what makes adding
    them a compatible change rather than a new format.
    """

    MAGIC = b"F8S1"
    HEADER_FORMAT = "<4sI"
    ENTRY_FORMAT = "<IIqq"
    MATRIX_MAGIC = b"F8M1"
    MATRIX_HEADER_FORMAT = "<4sIIqqHH"

    entries: List[ColumnBounds] = field(default_factory=list)
    matrices: List[BitMatrix] = field(default_factory=list)

    def to_bytes(self) -> bytes:
        header = struct.pack(self.HEADER_FORMAT, self.MAGIC, len(self.entries))
        entries = b"".join(
            struct.pack(self.ENTRY_FORMAT, entry.column_index, 0, entry.minimum, entry.maximum)
            for entry in sorted(self.entries, key=lambda entry: entry.column_index)
        )
        matrices = b"".join(
            struct.pack(
                self.MATRIX_HEADER_FORMAT,
                self.MATRIX_MAGIC,
                matrix.x.column_index,
                matrix.y.column_index,
                matrix.x.minimum,
                matrix.y.minimum,
                matrix.width,
                matrix.height,
            )
            + bytes(matrix.bits)
            for matrix in self.matrices
        )
        return header + entries + matrices


class DuckDB:
    """The duckdb CLI, used as the authority on the CSV's schema and values."""

    def __init__(self, explicit: Optional[str]):
        candidate = explicit or os.environ.get("F8_DUCKDB") or shutil.which("duckdb")
        if not candidate:
            sys.exit("no duckdb binary found - pass --duckdb, set F8_DUCKDB, or put duckdb on PATH")
        if not os.access(candidate, os.X_OK):
            sys.exit(f"{candidate} is not executable")
        self.binary = candidate

    def rows(self, sql: str) -> List[List[str]]:
        result = subprocess.run(
            [self.binary, "-csv", "-noheader", "-c", sql], capture_output=True, text=True
        )
        if result.returncode != 0:
            sys.exit(f"duckdb failed:\n{result.stderr.strip()}")
        return [row for row in csv.reader(io.StringIO(result.stdout)) if row]

    @staticmethod
    def string(value) -> str:
        return "'" + str(value).replace("'", "''") + "'"

    @staticmethod
    def identifier(name: str) -> str:
        return '"' + name.replace('"', '""') + '"'


def read_columns(duckdb: DuckDB, source: str) -> List[Column]:
    """The CSV's columns, in the order the parquet writer will use - what the metadata is keyed by."""
    schema = duckdb.rows(f"DESCRIBE SELECT * FROM {source}")
    return [
        Column(index=index, name=name, type=column_type)
        for index, (name, column_type, *_) in enumerate(schema)
    ]


def read_bounds(duckdb: DuckDB, source: str, columns: List[Column]) -> List[ColumnBounds]:
    """Bounds for every boundable column, in one query so a large CSV is read once."""
    boundable = [column for column in columns if column.boundable]
    if not boundable:
        return []

    projections = ", ".join(
        f"min({duckdb.identifier(column.name)}), max({duckdb.identifier(column.name)})"
        for column in boundable
    )
    values = duckdb.rows(f"SELECT {projections} FROM {source}")[0]

    bounds = []
    for position, column in enumerate(boundable):
        minimum, maximum = values[position * 2], values[position * 2 + 1]
        if minimum == "" or maximum == "":
            # An all-NULL column has no bounds. Leaving it out means "never skip", which is correct.
            continue
        bounds.append(
            ColumnBounds(
                column_index=column.index,
                name=column.name,
                minimum=int(minimum),
                maximum=int(maximum),
            )
        )
    return bounds


def read_matrices(duckdb: DuckDB, source: str, bounds: List[ColumnBounds]) -> List[BitMatrix]:
    """A bit matrix for every pair of columns narrow enough to be worth one.

    Every pair, not just adjacent ones: which pairs a query asks about is not something this can predict,
    and a matrix nobody asks about is only wasted bytes, while a missing one is a missed prune.
    """
    narrow = [
        bound for bound in bounds if bound.maximum - bound.minimum + 1 <= MAX_MATRIX_SPAN
    ]

    matrices = []
    for position, x in enumerate(narrow):
        for y in narrow[position + 1 :]:
            # NULLs cannot take part in an equality match, so a row with either side NULL says nothing
            # about which combinations exist.
            rows = duckdb.rows(
                f"SELECT DISTINCT {duckdb.identifier(x.name)}, {duckdb.identifier(y.name)} "
                f"FROM {source} "
                f"WHERE {duckdb.identifier(x.name)} IS NOT NULL "
                f"AND {duckdb.identifier(y.name)} IS NOT NULL"
            )
            matrices.append(
                BitMatrix.build(x, y, ((int(row[0]), int(row[1])) for row in rows))
            )
    return matrices


def main():
    parser = argparse.ArgumentParser(
        description="Build a min/maxtrix metadata blob from a CSV file."
    )
    parser.add_argument("csv", help="input CSV file")
    parser.add_argument("metadata", help="output metadata file")
    parser.add_argument("--duckdb", help="duckdb binary to use (default: $F8_DUCKDB or PATH)")
    args = parser.parse_args()

    csv_path = pathlib.Path(args.csv)
    if not csv_path.exists():
        sys.exit(f"{csv_path} not found")

    duckdb = DuckDB(args.duckdb)
    source = f"read_csv({DuckDB.string(csv_path)})"

    columns = read_columns(duckdb, source)
    if not columns:
        sys.exit(f"{csv_path} has no columns")

    bounds = read_bounds(duckdb, source, columns)
    metadata = Metadata(entries=bounds, matrices=read_matrices(duckdb, source, bounds))
    blob = metadata.to_bytes()
    pathlib.Path(args.metadata).write_bytes(blob)

    print(
        f"wrote {args.metadata}: {len(blob)} bytes, {len(metadata.entries)} entry(ies), "
        f"{len(metadata.matrices)} matrix(es)"
    )
    for entry in metadata.entries:
        print(entry.describe())
    for matrix in metadata.matrices:
        print(matrix.describe())
    bounded = {entry.column_index for entry in metadata.entries}
    unbounded = [column.name for column in columns if column.index not in bounded]
    if unbounded:
        print(f"  no entry, so never skipped: {', '.join(unbounded)}")


if __name__ == "__main__":
    main()
